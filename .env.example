# ==============================================================================
# VeriMoo Environment Variables
# For local development: copy to .env.local
# For Vercel deployment: configure these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# 1. MongoDB Connection String (Required)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cert-system?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cert-system

# 2. NextAuth Authentication (Required)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=verimoo-production-secret-key-2026-auth-token
# In local: http://localhost:3000 | In Vercel: https://your-project.vercel.app
NEXTAUTH_URL=http://localhost:3000

# 3. Base URL for QR Codes & Public Verification (Required for live QR scans)
# In local: http://localhost:3000 | In Vercel: https://your-project.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 4. Initial Seed Administrator (Used by scripts/seed-admin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Str0ngPass!2026

# 5. Google Gemini AI Suggestions (Optional)
# If set, enables AI wording suggestions in Certificate Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 6. Data Encryption Key (Optional)
# Used to encrypt sensitive stored credentials (e.g. Gmail app passwords)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
