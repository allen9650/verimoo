# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/cert-system

# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Seed admin (used by scripts/seed-admin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Base URL used inside QR codes for verification links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AI text suggestions (optional — the "AI Suggest" button on title/heading
# fields is disabled with a clear message if this isn't set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Encrypts sensitive per-project secrets (currently: Gmail app passwords used
# for the "Email certificates" feature) before they're stored in MongoDB.
# Generate with: openssl rand -hex 32
# Falls back to NEXTAUTH_SECRET if unset, but set a dedicated key for real
# deployments so rotating one secret doesn't affect the other.
ENCRYPTION_KEY=
